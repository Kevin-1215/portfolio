{
  "name": "kevin-digital-craft",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "check": "tsc --noEmit",
    "api:dev": "wrangler dev --config cloudflare/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "api:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "api:migrate": "wrangler d1 migrations apply DB --config cloudflare/wrangler.jsonc --remote",
    "test:api": "node scripts/check-hybrid-api.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
