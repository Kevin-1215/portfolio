{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kevin-portfolio-api",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://kevin-1215.github.io,http://127.0.0.1:5173,http://localhost:5173" },
  "d1_databases": [{ "binding": "DB", "database_name": "kevin-portfolio", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
