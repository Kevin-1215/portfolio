{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src/**/*.tsx",
    "components/site.tsx",
    "components/portfolio.tsx",
    "components/members.tsx",
    "components/shop.tsx",
    "components/aura.tsx",
    "components/auth-form.tsx",
    "lib/client.ts",
    "lib/catalog.ts",
    "cloudflare/worker.ts",
    "vite.config.ts",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "dist",
    ".vinext",
    ".wrangler",
    ".sites-runtime",
    "outputs",
    "work"
  ]
}
